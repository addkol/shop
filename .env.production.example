PAYMENT_WEBHOOK_MAX_BODY_BYTES=131072

SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05
PAYMENT_LOG_LEVEL=INFO
BACKUP_ROOT=/opt/onlineshop/backups
