ENVIRONMENT=production
DEBUG=False
COMPOSE_PROJECT_NAME=elit-market
SECRET_KEY=replace-with-at-least-50-random-characters
ALLOWED_HOSTS=shop.example.com
CSRF_TRUSTED_ORIGINS=https://shop.example.com
SITE_URL=https://shop.example.com
TIME_ZONE=Asia/Bishkek

APP_PORT=8010
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=45
GUNICORN_FORWARDED_ALLOW_IPS=127.0.0.1

POSTGRES_DB=online_shop
POSTGRES_USER=online_shop
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DB_ENGINE=django.db.backends.postgresql
DB_NAME=online_shop
DB_USER=online_shop
DB_PASSWORD=replace-with-the-same-database-password
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=60

CACHE_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False
ORDER_EXPIRY_CHECK_SECONDS=60

CLIENT_IP_HEADER=HTTP_X_REAL_IP
CLIENT_IP_TRUSTED_HOPS=1
USE_X_FORWARDED_PROTO=True
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

STATIC_URL=/static/
STATIC_ROOT=/app/staticfiles
MEDIA_URL=/media/
MEDIA_ROOT=/app/media
SERVE_MEDIA_FILES=False
USE_S3=False
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_REGION_NAME=
S3_CUSTOM_DOMAIN=
S3_QUERYSTRING_AUTH=False

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL="Элит Маркет <noreply@example.com>"
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_TLS=True

SMS_PROVIDER=twilio
FIXED_OTP_CODE=
TWILIO_ACCOUNT_SID=replace-me
TWILIO_AUTH_TOKEN=replace-me
TWILIO_FROM_NUMBER=replace-me
SMS_CODE_TTL_SECONDS=300
SMS_MAX_ATTEMPTS=5
SMS_RESEND_COOLDOWN_SECONDS=60
SMS_REQUEST_WINDOW_SECONDS=3600
SMS_MAX_REQUESTS_PER_WINDOW=5
SMS_IP_MAX_REQUESTS_PER_WINDOW=20
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_SECONDS=900
ADMIN_EMAIL_VERIFICATION_TTL_SECONDS=86400

ORDER_PAYMENT_TTL_MINUTES=30
FINIK_API_URL=https://api.acquiring.averspay.kg/v1/payment
FINIK_STATUS_API_URL=
FINIK_API_KEY=replace-me
FINIK_ACCOUNT_ID=replace-me
FINIK_DISPLAY_NAME="Elit Market"
FINIK_PRIVATE_KEY=replace-with-pem-using-escaped-newlines
FINIK_WEBHOOK_PUBLIC_KEY=replace-with-finik-production-public-key
FINIK_WEBHOOK_TOLERANCE_SECONDS=300
FINIK_USE_STUB=False
FINIK_TIMEOUT=15
FINIK_STATUS_MAX_BODY_BYTES=65536
FINIK_RECONCILIATION_INTERVAL_SECONDS=60
FINIK_RECONCILIATION_BATCH_SIZE=100
FINIK_RECONCILIATION_MIN_AGE_SECONDS=30
FINIK_RECONCILIATION_LOOKBACK_HOURS=72
